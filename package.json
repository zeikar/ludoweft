{
  "name": "ludoweft",
  "version": "0.0.3",
  "description": "Agent-native game localization: extract, translate, validate, and rebuild moddable game resources through a deterministic CLI.",
  "homepage": "https://github.com/zeikar/ludoweft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeikar/ludoweft.git"
  },
  "bugs": {
    "url": "https://github.com/zeikar/ludoweft/issues"
  },
  "author": {
    "name": "zeikar",
    "url": "https://github.com/zeikar"
  },
  "type": "module",
  "bin": {
    "ludoweft": "./bin/ludoweft.mjs"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "bin",
    "examples",
    "schemas",
    "skills",
    "src"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node ./bin/ludoweft.mjs pipeline --project ./examples/demo/ludoweft.project.json",
    "plugin:smoke": "node ./skills/ludoweft-localize/scripts/ludoweft.mjs help",
    "validate:demo": "node ./bin/ludoweft.mjs validate --project ./examples/demo/ludoweft.project.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "claude-code",
    "claude-code-plugin",
    "cli",
    "codex-plugin",
    "game-localization",
    "jsonl",
    "localization",
    "modding",
    "translation",
    "visual-novel"
  ],
  "license": "MIT"
}
